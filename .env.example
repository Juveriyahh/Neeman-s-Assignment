# ---------------------------------------------------------------------------
# Landing Page Pre-Flight Auditor
# Copy to .env and fill in. Everything here is optional: with no keys at all
# the tool still runs a full browser session and all eight deterministic
# checks, and degrades visibly rather than failing.
# ---------------------------------------------------------------------------

PORT=3001

# The page audited when none is supplied.
DEFAULT_TARGET_URL=https://neemans.com/products/curve-knit-slip-ons-for-men-ivory

# Google Gemini -- powers STAGE 3 (business interpretation) only.
# Without it the report is deterministic-only and says so, loudly, in the UI.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Supabase -- run logging. Without it, runs are kept in memory for the
# lifetime of the process. Apply schema.sql first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
